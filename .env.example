# ============================================================================
# Customer Churn Prediction API - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# Project Root (optional - auto-detected if not set)
# PROJECT_ROOT=/path/to/churn-prediction-analytics

# ============================================================================
# PATHS CONFIGURATION
# ============================================================================

# Path to ML model files (xgb_tuned_model.pkl, scaler.pkl, label_encoders.pkl)
# Can be relative to PROJECT_ROOT or absolute path
MODELS_PATH=../models

# Path to processed data files (customer_predictions.csv, retention_actions.csv)
# Can be relative to PROJECT_ROOT or absolute path  
DATA_PATH=../data/processed

# ============================================================================
# MODEL FILES
# ============================================================================

MODEL_FILE=xgb_tuned_model.pkl
SCALER_FILE=scaler.pkl
ENCODERS_FILE=label_encoders.pkl

# ============================================================================
# DATA FILES
# ============================================================================

PREDICTIONS_FILE=customer_predictions.csv
RETENTION_FILE=retention_actions.csv
MODEL_COMPARISON_FILE=model_comparison.csv

# ============================================================================
# API CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501

# ============================================================================
# DATABASE CONFIGURATION (for future use)
# ============================================================================

# DATABASE_URL=sqlite:///./churn.db
# DATABASE_URL=postgresql://user:password@localhost:5432/churn_db

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
