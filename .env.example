# ============================================================================
# Customer Churn Prediction API - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment

# Project Root (optional - auto-detected if not set)
# PROJECT_ROOT=/path/to/churn-prediction-analytics

# ============================================================================
# PATHS CONFIGURATION
# ============================================================================

# Path to ML model files (xgb_tuned_model.pkl, scaler.pkl, label_encoders.pkl)
# Can be relative to PROJECT_ROOT or absolute path
MODELS_PATH=../models

# Path to processed data files (customer_predictions.csv, retention_actions.csv)
# Can be relative to PROJECT_ROOT or absolute path  
DATA_PATH=../data/processed

# ============================================================================
# MODEL FILES
# ============================================================================

MODEL_FILE=xgb_tuned_model.pkl
SCALER_FILE=scaler.pkl
ENCODERS_FILE=label_encoders.pkl

# ============================================================================
# DATA FILES
# ============================================================================

PREDICTIONS_FILE=customer_predictions.csv
RETENTION_FILE=retention_actions.csv
MODEL_COMPARISON_FILE=model_comparison.csv

# ============================================================================
# API CONFIGURATION
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000

# CORS - Allowed origins for frontend (comma-separated)
# Use * for development, specific URLs for production
# Examples:
#   Development: *
#   Production: https://your-frontend.com,https://app.yourdomain.com
ALLOWED_ORIGINS=*

# ============================================================================
# DATABASE CONFIGURATION - AWS RDS (MySQL)
# ============================================================================

# Connect to AWS RDS MySQL instance via MySQL Workbench
#
# SETUP STEPS:
# 1. Create AWS RDS MySQL instance
# 2. Connect to RDS from MySQL Workbench:
#    - Hostname: your-rds-endpoint.region.rds.amazonaws.com
#    - Port: 3306
#    - Username: admin (or your master username)
#    - Password: your RDS password
# 3. Create a new schema/database in Workbench:
#    CREATE DATABASE churn_prediction;
# 4. Set the DATABASE_URL below with your RDS credentials
#
# FORMAT: mysql+pymysql://username:password@rds-endpoint:3306/database
#
# Example:
# DATABASE_URL=mysql+pymysql://admin:mypassword@churn-db.abc123.us-east-1.rds.amazonaws.com:3306/churn_prediction

# SET YOUR AWS RDS DATABASE URL HERE:
DATABASE_URL=mysql+pymysql://admin:password@your-rds-endpoint.region.rds.amazonaws.com:3306/churn_prediction

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-12345

# Token expiry in minutes (default: 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
